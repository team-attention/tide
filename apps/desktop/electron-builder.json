{
  "appId": "app.tide.v2",
  "productName": "Tide",
  "directories": {
    "output": "dist/package-mac"
  },
  "files": [
    "out/**",
    "package.json"
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "build/icon.icns"
  },
  "dmg": {
    "title": "${productName}",
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      { "x": 150, "y": 190, "type": "file" },
      { "x": 390, "y": 190, "type": "link", "path": "/Applications" }
    ],
    "internetEnabled": false
  }
}
