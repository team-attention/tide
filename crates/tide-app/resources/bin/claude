#!/bin/sh
# Tide auto-injected wrapper for Claude Code.
# Uses --mcp-config (additive MCP) + --settings (hooks combined from all sources).
# Neither flag replaces the user's existing configuration.

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_CMD="$(PATH="$(echo "$PATH" | sed "s|${SELF_DIR}:||g; s|:${SELF_DIR}||g; s|${SELF_DIR}||g")" command -v claude 2>/dev/null)"
[ -z "$REAL_CMD" ] && echo "claude: command not found" >&2 && exit 127

# Skip injection if not inside Tide
[ -z "$TIDE_BIN" ] && exec "$REAL_CMD" "$@"

MCP_FILE="$(mktemp /tmp/tide-claude-mcp.XXXXXX)"
HOOKS_FILE="$(mktemp /tmp/tide-claude-hooks.XXXXXX)"
trap 'rm -f "$MCP_FILE" "$HOOKS_FILE"' EXIT

tide_notify() {
  "$TIDE_BIN" notify "$1" --pane "$TIDE_PANE" --agent claude >/dev/null 2>&1 || \
    printf '\033]9;tide:wrapped-agent:claude:%s\007' "$1"
}

# --mcp-config: additive MCP servers (merged with user's ~/.claude.json and .mcp.json)
cat > "$MCP_FILE" << TIDE_EOF
{
  "mcpServers": {
    "tide": {
      "type": "stdio",
      "command": "$TIDE_BIN",
      "args": ["mcp"],
      "env": { "TIDE_SOCKET": "$TIDE_SOCKET", "TIDE_PANE": "$TIDE_PANE" }
    }
  }
}
TIDE_EOF

# --settings: hooks use matcher + hooks array format.
# Combined from all sources (user + project + this) — never replaces user hooks.
cat > "$HOOKS_FILE" << TIDE_EOF
{
  "hooks": {
    "Notification": [{"matcher": "", "hooks": [{"type": "command", "command": "$TIDE_BIN notify agent-needs-input --pane $TIDE_PANE --agent claude"}]}],
    "Stop": [{"matcher": "", "hooks": [{"type": "command", "command": "$TIDE_BIN notify agent-idle --pane $TIDE_PANE --agent claude"}]}],
    "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "$TIDE_BIN notify agent-running --pane $TIDE_PANE --agent claude"}]}]
  }
}
TIDE_EOF

tide_notify agent-running
trap 'tide_notify agent-idle; rm -f "$MCP_FILE" "$HOOKS_FILE"' EXIT

"$REAL_CMD" --mcp-config "$MCP_FILE" --settings "$HOOKS_FILE" "$@"
