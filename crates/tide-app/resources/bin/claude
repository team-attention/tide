#!/bin/sh
# Tide auto-injected wrapper for Claude Code.
# Uses --mcp-config (additive MCP) + --settings (hooks combined from all sources).
# Neither flag replaces the user's existing configuration.

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_CMD="$(PATH="$(echo "$PATH" | sed "s|${SELF_DIR}:||g; s|:${SELF_DIR}||g; s|${SELF_DIR}||g")" command -v claude 2>/dev/null)"
[ -z "$REAL_CMD" ] && echo "claude: command not found" >&2 && exit 127

# Skip injection if not inside Tide
[ -z "$TIDE_BIN" ] && exec "$REAL_CMD" "$@"

TIDE_WRAPPER_CONFIG_ROOT="${TIDE_WRAPPER_CONFIG_ROOT:-${XDG_STATE_HOME:-$HOME/Library/Application Support/Tide}/agent-wrappers}"
TIDE_CLAUDE_CONFIG_DIR="$TIDE_WRAPPER_CONFIG_ROOT/claude"
MCP_FILE="$(mktemp /tmp/tide-claude-mcp.XXXXXX)"
HOOKS_FILE="$TIDE_CLAUDE_CONFIG_DIR/hooks.json"
mkdir -p "$TIDE_CLAUDE_CONFIG_DIR"
trap 'rm -f "$MCP_FILE"' EXIT

TIDE_CONTEXT_PROMPT="$(cat <<'TIDE_CONTEXT_EOF'
You are running inside Tide, a terminal-centered task Workspace.

Tide has a Stage for the primary Terminal, a Terminal Context Surface for supporting Panes, a FileTree View, a Workspace rail, and Pane kinds Terminal, Editor, Diff, Browser, and Launcher.

When the user asks to open, show, view, browse, inspect, preview, navigate to, or display a file, URL, webpage, local server, Pane, or Tide surface, prefer Tide MCP tools before shell commands that open macOS default apps.

- Use `tide_open_browser` for URLs, webpages, local previews, and browser inspection inside a Tide Browser Pane.
- Use `tide_open_editor` for existing source or text files inside a Tide Editor Pane.
- Use `tide_observe_workspace` when you need current Stage, Terminal Context Surface, Pane geometry, or focus.

Use macOS `open` only when the user explicitly asks for the default app or external browser, or when Tide tools cannot represent the target.
TIDE_CONTEXT_EOF
)"

tide_notify() {
  "$TIDE_BIN" notify "$1" --pane "$TIDE_PANE" --agent claude >/dev/null 2>&1 || \
    printf '\033]9;tide:wrapped-agent:claude:%s\007' "$1"
}

# --mcp-config: additive MCP servers (merged with user's ~/.claude.json and .mcp.json)
cat > "$MCP_FILE" << TIDE_EOF
{
  "mcpServers": {
    "tide": {
      "type": "stdio",
      "command": "$TIDE_BIN",
      "args": ["mcp"],
      "env": { "TIDE_SOCKET": "$TIDE_SOCKET", "TIDE_PANE": "$TIDE_PANE" }
    }
  }
}
TIDE_EOF

# --settings: hooks use matcher + hooks array format.
# Combined from all sources (user + project + this) — never replaces user hooks.
cat > "$HOOKS_FILE" <<'TIDE_EOF'
{
  "hooks": {
    "Notification": [{"matcher": "", "hooks": [{"type": "command", "command": "\"$TIDE_BIN\" notify agent-needs-input --pane \"$TIDE_PANE\" --agent claude --payload-stdin"}]}],
    "Stop": [{"matcher": "", "hooks": [{"type": "command", "command": "\"$TIDE_BIN\" notify agent-idle --pane \"$TIDE_PANE\" --agent claude --payload-stdin"}]}],
    "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "\"$TIDE_BIN\" notify agent-running --pane \"$TIDE_PANE\" --agent claude"}]}]
  }
}
TIDE_EOF

tide_notify agent-attached
trap 'tide_notify agent-detached; rm -f "$MCP_FILE"' EXIT

"$REAL_CMD" --mcp-config "$MCP_FILE" --settings "$HOOKS_FILE" --append-system-prompt "$TIDE_CONTEXT_PROMPT" "$@"
