#!/bin/sh
# Tide auto-injected wrapper for Codex CLI.
# Uses -c flag for additive config injection (deep table merge — new keys additive)
# plus a temporary hooks.json overlay so Tide can observe UserPromptSubmit,
# PermissionRequest, and Stop without mutating the user's real CODEX_HOME.

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_CMD="$(PATH="$(echo "$PATH" | sed "s|${SELF_DIR}:||g; s|:${SELF_DIR}||g; s|${SELF_DIR}||g")" command -v codex 2>/dev/null)"
[ -z "$REAL_CMD" ] && echo "codex: command not found" >&2 && exit 127

# Skip injection if not inside Tide
[ -z "$TIDE_BIN" ] && exec "$REAL_CMD" "$@"

REAL_CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
TIDE_CODEX_HOME="$(mktemp -d /tmp/tide-codex-home.XXXXXX)"
HOOKS_FILE="$TIDE_CODEX_HOME/hooks.json"

# Wrapper-owned OSC 9 helper used only as a fallback when `tide notify` is unavailable.
tide_osc9() { printf '\033]9;%s\007' "$1"; }

tide_notify() {
  "$TIDE_BIN" notify "$1" --pane "$TIDE_PANE" --agent codex >/dev/null 2>&1 || \
    tide_osc9 "tide:wrapped-agent:codex:$1"
}

# Report wrapper-managed presence on start and Idle on exit.
tide_notify "agent-attached"

# Build a temporary CODEX_HOME overlay so Tide can add hooks.json without
# mutating the user's real Codex home. Existing config/state entries are
# symlinked through, while Tide owns the overlay hooks file.
if [ -d "$REAL_CODEX_HOME" ]; then
  for entry in "$REAL_CODEX_HOME"/* "$REAL_CODEX_HOME"/.[!.]* "$REAL_CODEX_HOME"/..?*; do
    [ -e "$entry" ] || continue
    base="$(basename "$entry")"
    [ "$base" = "hooks.json" ] && continue
    ln -s "$entry" "$TIDE_CODEX_HOME/$base"
  done
fi

if [ -f "$REAL_CODEX_HOME/hooks.json" ] && command -v python3 >/dev/null 2>&1; then
  TIDE_RUNNING_HOOK_COMMAND="$TIDE_BIN notify agent-running --pane $TIDE_PANE --agent codex" \
  TIDE_PERMISSION_REQUEST_HOOK_COMMAND="$TIDE_BIN notify agent-needs-input --pane $TIDE_PANE --agent codex --payload-stdin" \
  TIDE_STOP_HOOK_COMMAND="$TIDE_BIN notify codex-stop --pane $TIDE_PANE --agent codex --payload-stdin" \
    python3 - "$REAL_CODEX_HOME/hooks.json" "$HOOKS_FILE" <<'PY'
import json
import os
import sys

src, dst = sys.argv[1], sys.argv[2]
with open(src, "r", encoding="utf-8") as f:
    data = json.load(f)

hooks = data.setdefault("hooks", {})

def append_command_hook(event_name: str, command: str, matcher: str | None = None) -> None:
    groups = hooks.setdefault(event_name, [])
    group = {
        "hooks": [
            {
                "type": "command",
                "command": command,
            }
        ]
    }
    if matcher is not None:
        group["matcher"] = matcher
    groups.append(group)

append_command_hook("UserPromptSubmit", os.environ["TIDE_RUNNING_HOOK_COMMAND"])
append_command_hook(
    "PermissionRequest",
    os.environ["TIDE_PERMISSION_REQUEST_HOOK_COMMAND"],
    matcher="Bash",
)
append_command_hook("Stop", os.environ["TIDE_STOP_HOOK_COMMAND"])

with open(dst, "w", encoding="utf-8") as f:
    json.dump(data, f)
PY
else
  cat > "$HOOKS_FILE" << TIDE_EOF
{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$TIDE_BIN notify agent-running --pane $TIDE_PANE --agent codex"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$TIDE_BIN notify agent-needs-input --pane $TIDE_PANE --agent codex --payload-stdin"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$TIDE_BIN notify codex-stop --pane $TIDE_PANE --agent codex --payload-stdin"
          }
        ]
      }
    ]
  }
}
TIDE_EOF
fi

trap 'tide_notify "agent-detached"; rm -rf "$TIDE_CODEX_HOME"' EXIT

codex_direct_launch() {
  CODEX_HOME="$TIDE_CODEX_HOME" "$REAL_CMD" \
    -c "features.codex_hooks=true" \
    -c "plugins.\"browser-use@openai-bundled\".enabled=false" \
    -c "mcp_servers.tide.command=\"$TIDE_BIN\"" \
    -c "mcp_servers.tide.args=[\"mcp\"]" \
    -c "mcp_servers.tide.env.TIDE_SOCKET=\"$TIDE_SOCKET\"" \
    -c "mcp_servers.tide.env.TIDE_PANE=\"$TIDE_PANE\"" \
    "$@"
}

codex_direct_launch "$@"
exit $?
