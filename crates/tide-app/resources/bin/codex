#!/bin/sh
# Tide auto-injected wrapper for Codex CLI.
# Uses -c flag for additive MCP server injection (deep table merge — new keys additive).
# Codex CLI has no repo-visible external hook injection path (unlike Claude/Gemini),
# so this wrapper only guarantees Running on launch and Idle on exit.

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_CMD="$(PATH="$(echo "$PATH" | sed "s|${SELF_DIR}:||g; s|:${SELF_DIR}||g; s|${SELF_DIR}||g")" command -v codex 2>/dev/null)"
[ -z "$REAL_CMD" ] && echo "codex: command not found" >&2 && exit 127

# Skip injection if not inside Tide
[ -z "$TIDE_BIN" ] && exec "$REAL_CMD" "$@"

# Wrapper-owned OSC 9 helper used only as a fallback when `tide notify` is unavailable.
tide_osc9() { printf '\033]9;%s\007' "$1"; }

tide_notify() {
  "$TIDE_BIN" notify "$1" --pane "$TIDE_PANE" --agent codex >/dev/null 2>&1 || \
    tide_osc9 "tide:wrapped-agent:codex:$1"
}

# Report Running on start and Idle on exit. Codex does not emit NeedsInput here.
tide_notify "agent-running"
trap 'tide_notify "agent-idle"' EXIT

"$REAL_CMD" \
  -c "mcp_servers.tide.command=\"$TIDE_BIN\"" \
  -c "mcp_servers.tide.args=[\"mcp\"]" \
  -c "mcp_servers.tide.env.TIDE_SOCKET=\"$TIDE_SOCKET\"" \
  -c "mcp_servers.tide.env.TIDE_PANE=\"$TIDE_PANE\"" \
  -c "features.codex_hooks=true" \
  "$@"
